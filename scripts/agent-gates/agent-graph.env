# Project profile for the agent graph (sourced by agent-graph.sh and by orca-factory-driver).
# Everything project-specific lives here or in gate.project.sh / COORDINATOR.project.md.
# 填法：把每个花括号占位换成实际值，保留行尾注释里的人类可读名字，方便复核。值含空格或 $ 时用单引号。
# 值来源见 ONBOARD.md 第 1-3 步。install.sh 会校验必填变量非空、档位格式（两个冒号），按所选账本验证仓库与票据访问。

AGENT_GH_REPO=vmxmy/gpt-ziikoo-app                           # GitHub 仓库（依据：git remote get-url origin；driver onboard 默认值）
AGENT_ISSUE_BACKEND=feishu                                 # 唯一执行账本（依据：driver onboard 默认值，取自 orca-factory 本仓库配置）
AGENT_FEISHU_BASE=https://qcnqhljeakpl.feishu.cn/base/VeQObWd9VaV66tsiM7GcN0Avnph   # 生产 Base「orca-factory 研发票据账本」
AGENT_FEISHU_PROJECT=github.com/vmxmy/gpt-ziikoo-app         # 项目表“仓库远端”（Orca canonicalKey；编号前缀 GZA）
AGENT_FEISHU_NOTIFY_CHAT=oc_df5a2e4c1ec67b188874dce44e9e702c   # 本项目专属群「研发流水线 | gpt-ziikoo-app」（OF-304）：接收通知，也是 @ 机器人提需求的入口
AGENT_MAX_IN_FLIGHT=2                                        # 同时在途票上限（依据：用户答复，采用默认 2）
AGENT_SCOPE_AVOID=1                                          # 1=driver 按 SCOPE 排除与在途票重叠的候选（默认，稳健）；0=driver 不做任何 SCOPE 过滤，并行冲突交给合并阶段 workflow §2 的 rebase 规则
AGENT_SCOPE_SHARED=''                                        # 空格分隔的路径或 glob；被完整覆盖的 SCOPE 条目不参与 driver 的 SCOPE 避让（如按 key 追加的字典文件），并行改动的文本冲突由合并通道转打回修改；空=全部参与
AGENT_STALE_HOURS=8   # 在途票超过此时长无票据更新 -> driver 判为陈旧
AGENT_RUN_WORKTREE_PREFIX=auto-agent-linear-scan-            # Orca 定时任务 worktree 名前缀，prune-run-worktrees.sh 据此清理；一般不改
AGENT_INSTALL_CMD='pnpm install --frozen-lockfile'           # 工人在新 worktree 里装依赖（依据：pnpm-lock.yaml 与 CI install 步；mock/ 无锁文件、不在 workspace 内，CI 不装它）
AGENT_DEPLOY_WORKFLOW=''                                     # 无自动部署（依据：.github/workflows 只有 ci.yml，main 只跑 cf deploy --dry-run；docs/architecture.md「发布」：维护者本机手动部署；用户答复留空）
AGENT_SMOKE_CMD=''                                           # 同上，无自动部署时合并后的线上版本不变，smoke 无意义（依据：用户答复留空）
# Model tiers (ONBOARD 第 1 步「角色后端」行、第 3 步问答). 格式 agent:model:effort；coordinator 按 workflow.md §6 解析后拆成
# worker-start --agent/--model/--effort。model 可空（codex::low = 该 agent 的默认模型，此时 --model/--effort 都不传）。
AGENT_TIER_DEFAULT='codex:gpt-6.1-sol:high'       # 依据：driver onboard 默认值，与其他接入项目一致
AGENT_TIER_STRONG='codex:gpt-6.1-sol:xhigh'
AGENT_ROLE_RESOLVER='claude:claude-opus-5-5:high'   # 处置 Agent 显式档位，不随 strong 档变化
AGENT_ROLE_INTAKE='claude:claude-opus-5-5:high'     # 需求助手与接入 Agent 显式档位，必须是 claude，不随 strong 档变化
AGENT_TIER_ESCALATE=1                           # 1=被打回一次后下一轮 correction 自动升一档；0=不升
AGENT_ROLE_REVIEWER_CMD='env -u ORCA_PANE_KEY -u ORCA_AGENT_HOOK_PORT -u ORCA_AGENT_HOOK_TOKEN codex exec -m gpt-6-astra -c model_reasoning_effort=high --sandbox read-only -'   # lane 2 异构审查命令，在单元 worktree 内执行，roles/reviewer.md + 简报经 stdin 传入；可空=不做
AGENT_ROLE_REVIEWER_CMD_SMALL=''             # estimate 不大于阈值时的小票审查命令；空=沿用主审查命令
AGENT_REVIEWER_SMALL_MAX_ESTIMATE=2          # 小票审查 estimate 上限（含）
# Lane globs: space-separated bash globs matched by gate.sh ([[ $f == $g ]], '*' spans '/').
# A changed file matching LANE3 -> gate red (never automated); matching LANE2 -> LANE 2 (automerge is opt-in; see AGENT_LANE2_AUTOMERGE).
# scripts/agent-gates/* is always lane 2 (hard-coded in gate.sh).
# 判据与依据见 COORDINATOR.project.md「Lane 判据」。
AGENT_LANE2_GLOBS='.github/* package.json pnpm-lock.yaml pnpm-workspace.yaml mock/package.json cloudflare.config.ts mock/cloudflare.config.ts tsconfig*.json vite.config.ts mock/vite.config.ts vitest.config.ts playwright.config.ts docs/* public/_headers src/shared/types.ts src/worker/index.ts src/worker/identity.ts src/worker/redact.ts src/worker/target-url.ts src/worker/request.ts src/worker/watch.ts src/web/html-test.tsx AGENTS.md CLAUDE.md .claude/* .codex/* scripts/agent-gates/*'
AGENT_LANE3_GLOBS='.env* */.env* .dev.vars* */.dev.vars* *secrets* .github/workflows/deploy* .cloudflare/* */.cloudflare/*'
AGENT_LANE2_AUTOMERGE=1                         # 1=lane 2 满足复核、CI 与路径条件后自合（依据：用户答复）；0=交给 resolver 复核
AGENT_LANE2_MANUAL_GLOBS=''                      # 空格分隔 bash glob，与 gate.sh 的 match_any 一致，* 跨 /；命中后由 resolver 复核；lane 3 仍禁止自动推进
